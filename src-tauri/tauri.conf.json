{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMEazy POS",
  "version": "2.6.1",
  "identifier": "ke.co.cotr.smeazypos",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SMEazy POS",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/smeazy-api"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNkU3RjU4NUM5OUQ1MjIKUldRaTFabGNXSDl1ZzZjSnZ2V0c5enFhTE0xRkhHMlhkeDJiQTN3cmRGdmZzR2E2ZFFsUTFhWTcK",
      "endpoints": [
        "https://github.com/k-nkoroi/smeazy-pos/releases/latest/download/latest.json"
      ]
    }
  }
}
