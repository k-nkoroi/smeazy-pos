# SMEazy V2 — Environment Variables
# Copy this file to .env and edit before running

# SQLite database file path (created automatically if missing)
DATABASE_PATH=smeazy.db

# JWT secret — CHANGE THIS in production (min 32 characters)
JWT_SECRET=smeazy-v2-change-this-secret-now!!

# API server port
PORT=8000

# Log level: error | warn | info | debug | trace
RUST_LOG=smeazy_api=info,tower_http=warn
